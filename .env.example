# ── Server ───────────────────────────────────────────────────────────
PORT=3001
TIMEZONE=America/Sao_Paulo
# DATA_DIR=/app/data          # diretorio de dados (SQLite, JSON). Padrao: src/data
# AUDIO_DIR=/app/audio        # diretorio de audio. Padrao: src/audio
# AUDIO_INPUT_DIR=/app/audio/input
# AUDIO_OUTPUT_DIR=/app/audio/output
# DB_PATH=/app/data/jarvis.sqlite
# MEMORY_PATH=/app/data/memory.json
# REMINDERS_PATH=/app/data/reminders.json

# ── Autenticacao ───────────────────────────────────────────────────────
# JARVIS_API_TOKEN=            # se definido, protege rotas protegidas por token

# ── IA (Ollama) ──────────────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_COMMAND=llama3.2:3b
OLLAMA_MODEL_CHAT=llama3.2:3b
OLLAMA_MODEL_FALLBACK=llama3.2:3b
# OLLAMA_RETRIES=2             # retentativas automaticas em falhas de rede
# OLLAMA_RETRY_DELAY_MS=500  # atraso entre retentativas (backoff linear)

# ── TTS ─────────────────────────────────────────────────────────────────────────
TTS_PROVIDER=fish_audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_TIMEOUT_MS=12000
# TTS_LOCAL_FALLBACK=piper     # piper, none ou disabled
# PIPER_COMMAND=               # ex: piper-tts --model pt_BR.pt --output_file {output} --text {text}
# PIPER_TIMEOUT_MS=30000

# ── Home Assistant ───────────────────────────────────────────────────────────
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITY=light.luz_quarto

# ── Voz local (microfone, STT, wake word) ───────────────────────────────────
MIC_RECORDING_ENABLED=false
VOICE_LISTENER_ENABLED=false
WAKE_LOOP_ENABLED=false
# MIC_RECORD_COMMAND=          # ex: rec -q -r 16000 -c 1 -b 16 {output} trim 0 {duration}
# STT_PROVIDER=local           # local ou openai
# STT_LOCAL_COMMAND=           # ex: whisper-ctranslate2 {input} --model small
# OPENAI_API_KEY=              # para STT remoto (whisper)

# ── Rede / Offline ────────────────────────────────────────────────────────────────
# OFFLINE_MODE=auto            # auto, always, never
# INTERNET_CHECK_URL=https://www.gstatic.com/generate_204
# INTERNET_CHECK_INTERVAL_MS=60000
# INTERNET_CHECK_TIMEOUT_MS=2500

# ── Rate Limit ─────────────────────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# TRUST_PROXY=false
