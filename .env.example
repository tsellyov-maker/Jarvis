PORT=3000
BIND_HOST=127.0.0.1
ENABLE_PORT_FALLBACK=true
TIMEZONE=America/Sao_Paulo

JARVIS_API_TOKEN=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
LOG_FORMAT=text

DB_PATH=src/data/jarvis.sqlite

# OFFLINE_MODE:
# auto   = detecta internet e mantem recursos locais ativos quando cair
# always = nunca tenta servicos remotos como Fish Audio
# never  = sempre permite tentativa remota, com timeout/falha segura
OFFLINE_MODE=auto
INTERNET_CHECK_URL=https://www.gstatic.com/generate_204
INTERNET_CHECK_INTERVAL_MS=60000
INTERNET_CHECK_TIMEOUT_MS=2500

AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_COMMAND=llama3.1
OLLAMA_MODEL_CHAT=mixtral
OLLAMA_MODEL_FALLBACK=llama3.1

FISH_AUDIO_API_KEY=76ef7407100242098c95e9047ff0e840
FISH_AUDIO_VOICE_ID=ec426c7ea3554caba8a5b077a4c701aa
FISH_AUDIO_TIMEOUT_MS=12000
TTS_PROVIDER=fish_audio

# Fallback futuro/local:
# Exemplo de Piper:
# TTS_LOCAL_FALLBACK=piper
# PIPER_COMMAND=printf %s {text} | piper --model /caminho/voz.onnx --output_file {output}
TTS_LOCAL_FALLBACK=piper
PIPER_COMMAND=
PIPER_TIMEOUT_MS=30000

STT_PROVIDER=local
STT_LOCAL_COMMAND=
MIC_RECORD_COMMAND=

AUDIO_PLAYBACK=true
AUDIO_PLAYER=auto

WAKE_WORD=jarvis

HA_URL=http://localhost:8123
HA_TOKEN=
HA_LIGHT_ENTITY=light.luz_quarto
